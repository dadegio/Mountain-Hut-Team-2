{
  "name": "mountain-hut-server",
  "version": "0.0.0",
  "description": "Software system capable of supporting the activities of a mountain hut",
  "license": "EUPL-1.2",
  "author": "group-02",
  "type": "module",
  "main": "index.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "nodemon",
